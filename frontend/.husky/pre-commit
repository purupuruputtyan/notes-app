#!/bin/sh
set -e

root="$(git rev-parse --show-toplevel)"
cd "$root"

if git diff --cached --name-only --diff-filter=ACM | grep -q '^backend/'; then
	"$root/backend/scripts/pre-commit.sh"
else
	echo "- no staged backend changes, skip backend checks"
fi

if git diff --cached --name-only --diff-filter=ACM | grep -q '^frontend/'; then
	cd "$root/frontend"
	npx lint-staged
	npm run lint
else
	echo "- no staged frontend changes, skip frontend checks"
fi
